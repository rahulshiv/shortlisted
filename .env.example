# Copy to .env (or export in your shell). Everything is optional for local use.

# Claude turns queries into criteria. Without it, a deterministic keyword heuristic is used.
ANTHROPIC_API_KEY=
# Model for criteria extraction (default claude-opus-5-5).
# SHORTLISTED_MODEL=claude-opus-5-5
# Force the heuristic even when a key is present: heuristic
# SHORTLISTED_CRITERIA=

# 32-byte Ed25519 seed (64 hex chars). Generate with `pnpm keygen`.
# If unset, a dev key is created in .data/dev-signing-key.hex and shared by all local processes.
SHORTLISTED_ED25519_PRIVATE_KEY=

# libsql URL. Default: file:.data/shortlisted.db. Works with Turso URLs too.
# SHORTLISTED_DB_URL=file:.data/shortlisted.db
# Auth token for a Turso (libsql://) database.
# SHORTLISTED_DB_AUTH_TOKEN=

# Public URL of the HTTP API (used in tender submit URLs and x402 resources).
SHORTLISTED_API_URL=http://localhost:8787
API_PORT=8787
MCP_PORT=8788
# Optional bearer token for the Streamable HTTP MCP endpoint.
# SHORTLISTED_MCP_TOKEN=

# Payments: "mock" (default) or "x402". x402 calls a facilitator and moves real (testnet) USDC.
SHORTLISTED_PAYMENTS=mock
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_NETWORK=base-sepolia
# X402_PAY_TO=0xYourReceivingAddress
